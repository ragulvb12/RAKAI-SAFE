# ==============================================================================
# RAKAI SAFE Backend — Environment Configuration (.env)
# ==============================================================================

PROJECT_NAME="RAKAI SAFE Backend API"
VERSION="2.0.0"
API_V1_STR="/api/v1"

# Security & JWT Tokens
SECRET_KEY="rakai-super-secret-jwt-key-2026-production-ready-change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL Only)
# ------------------------------------------------------------------------------
# Local Windows PostgreSQL (pgAdmin / Windows Service):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rakai_safe"

# Cloud PostgreSQL (Neon / Supabase / AWS RDS / Render):
# DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/rakai_safe?sslmode=require"

# ------------------------------------------------------------------------------
# SMS / Emergency Notification Gateway
# Options: "TWILIO" (default) or "MOCK_GATEWAY" (for tests)
# ------------------------------------------------------------------------------
SMS_PROVIDER="TWILIO"
SMS_API_KEY=""

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_PHONE_NUMBER=""
