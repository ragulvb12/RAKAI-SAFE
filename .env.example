# ==============================================================================
# RAKAI SAFE — Environment Configuration Template
# ==============================================================================

# Backend API Settings
PROJECT_NAME="RAKAI SAFE Backend API"
VERSION="2.0.0"
API_V1_STR="/api/v1"

# Security & JWT Token Authentication
SECRET_KEY="rakai-super-secret-jwt-key-2026-production-ready-change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL Only)
# ------------------------------------------------------------------------------
# 1. Local Windows PostgreSQL Development (pgAdmin / Native Service):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rakai_safe"

# 2. Cloud PostgreSQL Deployments (Supabase, Neon, Render, AWS RDS):
# DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/rakai_safe?sslmode=require"

# ------------------------------------------------------------------------------
# SMS / Emergency Notification Gateway
# Options: "TWILIO" (default) or "MOCK_GATEWAY" (for offline/dry-run testing)
# ------------------------------------------------------------------------------
SMS_PROVIDER="TWILIO"
SMS_API_KEY=""

# Twilio Credentials (Required if SMS_PROVIDER="TWILIO")
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_PHONE_NUMBER=""

# ------------------------------------------------------------------------------
# Frontend Environment Configuration
# ------------------------------------------------------------------------------
PORT=5173
VITE_API_URL="http://127.0.0.1:8000"
VITE_GOOGLE_MAPS_API_KEY="AIzaSyD7WEecs8VlqbKtGnBi4RfIsUvOO8NYmQM"
